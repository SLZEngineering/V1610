parse_args() {
  while (($#)); do
    case "$1" in
      --non-interactive)
        NON_INTERACTIVE=1
        ;;
      --easter-egg)
        show_easter_egg
        exit 0
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
    shift
  done
}

require_root() {
