init_logging() {
  mkdir -p "${LOG_DIR}" "${STATE_DIR}"
  chmod 750 "${LOG_DIR}" "${STATE_DIR}"
  touch "${LOG_FILE}"
  chmod 640 "${LOG_FILE}"
  # Preserve color in the terminal while keeping the persistent log free of
  # ANSI escape sequences.
  exec > >(tee -i >(sed -u 's/\x1B\[[0-9;]*[mK]//g' >> "${LOG_FILE}")) 2>&1
}

progress_message() {
  printf ' %s[+] %s%s\n' "${COLOR_GREEN}" "$1" "${COLOR_RESET}"
}

warning_message() {
  printf ' %s[!] WARNING: %s%s\n' "${COLOR_YELLOW}" "$1" "${COLOR_RESET}"
}

step_message() {
  CURRENT_STEP="$1 - $2"
  echo "------------------------------------------------------------"
  echo "Step $1: $2"
  echo "------------------------------------------------------------"
}

write_state() {
  local status="$1"
  shift || true
  local tmp="${STATE_FILE}.tmp.$$"

  {
    printf '%s\n' "${status}"
    printf 'revision=%s\n' "${REVISION}"
    printf 'script=%s\n' "${SCRIPT_NAME}"
    printf 'timestamp_utc=%s\n' "$(date -u +%FT%TZ)"
    printf 'step=%s\n' "${CURRENT_STEP}"
    for line in "$@"; do
      printf '%s\n' "${line}"
    done
  } > "${tmp}"

  chmod 640 "${tmp}"
  mv -f "${tmp}" "${STATE_FILE}"
}

backup_previous_state() {
  if [[ -f "${STATE_FILE}" ]]; then
    cp -a "${STATE_FILE}" "${STATE_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"
  fi
}


record_network_requirements() {
  cat > "${NETWORK_REQUIREMENTS_FILE}" <<'EOF'
Solutionz RMM Agent Network Requirements - Revision 5091126-V1610-LAB2-5NIC

Traffic model
- Monitoring traffic originates from the RMM Agent to monitored AV devices.
- RMM/Domotz cloud sessions are initiated outbound by the RMM Agent.
- No unsolicited Internet-initiated inbound connection is required for normal
  RMM/Domotz cloud communication.

Outbound TCP - cloud/platform
- TCP 443          Domotz portal/API/orchestration and Ubuntu/Canonical/Snap HTTPS
- TCP 5671         Domotz secure messaging/orchestration
- TCP 32700-57699  Domotz remote relay/secure remote connectivity
- TCP 4505-4506    Domotz provisioning
- TCP 55022        Domotz tunnel/remote support
- TCP 11371        Key-server/package provisioning or maintenance where required
- TCP 53           DNS fallback/large responses when the resolver requires TCP

Outbound/local UDP
- UDP 53           DNS queries when the resolver uses UDP transport
- UDP 123          NTP/time synchronization
- UDP 67/68        DHCP client/server exchange when eno0 is configured for DHCP
- UDP 161          SNMP polling from the RMM Agent to monitored devices when SNMP
                   monitoring is configured
- Additional UDP   As required by a specific monitored-device manufacturer protocol

Other required traffic
- ICMP             Device heartbeat/reachability, response-time and packet-loss tests
                   where the routed network/security policy permits ICMP

Local monitored-device traffic
- HTTP/HTTPS       TCP 80/443 when used by the monitored device
- SSH              TCP 22 when used for device monitoring/management
- SNMP             UDP 161 when SNMP polling is configured
- Manufacturer-specific TCP/UDP ports as required by the monitored device profile
- Routed networks/VLAN ACLs must permit the RMM Agent to reach each monitored
  device on the protocol/port required for that device.

Agent host firewall inbound allowances
- TCP 22           SSH administration
- TCP 3000         Local Domotz Agent service

UFW baseline
- Default incoming: deny
- Default outgoing: allow
- TCP 22: allow from any reachable source
- TCP 3000: allow from any reachable source
- No separate outbound TCP/UDP UFW rules are created because the host baseline is
  default-allow for outbound traffic. This does not override upstream firewall, ACL,
  VLAN, proxy, or perimeter-security restrictions.

Security boundary note
- Global TCP 22/TCP 3000 allowance on the RMM Agent host does not mean either port
  should be published through Internet NAT or permitted as unsolicited Internet
  inbound traffic. Perimeter policy remains responsible for preventing that exposure.
- Upstream firewalls must allow the required outbound TCP/UDP traffic and the local
  monitoring traffic needed for the monitored AV devices.
EOF
  chmod 640 "${NETWORK_REQUIREMENTS_FILE}"
  progress_message "Recorded network requirements: ${NETWORK_REQUIREMENTS_FILE}"
}

record_failure_and_exit() {
  local rc="$1"
  local line="$2"
  local command="$3"
  trap - ERR
  set +e
  write_state "phase1_failed" \
    "exit_code=${rc}" \
    "line=${line}" \
    "command=${command}"
  printf ' %s[!] INSTALLATION FAILED%s\n' "${COLOR_RED}" "${COLOR_RESET}"
  printf ' %s[!] Step: %s%s\n' "${COLOR_RED}" "${CURRENT_STEP}" "${COLOR_RESET}"
  printf ' %s[!] Line: %s%s\n' "${COLOR_RED}" "${line}" "${COLOR_RESET}"
  printf ' %s[!] Exit code: %s%s\n' "${COLOR_RED}" "${rc}" "${COLOR_RESET}"
  printf ' %s[!] Command: %s%s\n' "${COLOR_RED}" "${command}" "${COLOR_RESET}"
  printf ' %s[!] Log: %s%s\n' "${COLOR_RED}" "${LOG_FILE}" "${COLOR_RESET}"
  exit "${rc}"
}

on_error() {
  local rc=$?
  local line="$1"
  local command="$2"
  record_failure_and_exit "${rc}" "${line}" "${command}"
}

error_exit() {
  local message="$1"
  trap - ERR
  set +e
  printf ' %s[!] ERROR: %s%s\n' "${COLOR_RED}" "${message}" "${COLOR_RESET}"
  write_state "phase1_failed" "error=${message}"
  exit 1
}

trap 'on_error "${LINENO}" "${BASH_COMMAND}"' ERR

