STATE_FILE="/var/lib/rswsolutionz-rmm/install.state"
PACKAGE_BASELINE_FILE="/var/lib/rswsolutionz-rmm/package-baseline-5091126-V1610-LAB2-5NIC.tsv"
OS_BASELINE_FILE="/var/lib/rswsolutionz-rmm/os-baseline-5091126-V1610-LAB2-5NIC.txt"
MANUFACTURER_BASELINE_FILE="/var/lib/rswsolutionz-rmm/manufacturer-baseline-5091126-V1610-LAB2-5NIC.txt"
MANUFACTURER_PACKAGE_BASELINE_FILE="/var/lib/rswsolutionz-rmm/manufacturer-packages-5091126-V1610-LAB2-5NIC.tsv"
MANUFACTURER_PACKAGE_VALIDATION_FILE="/var/lib/rswsolutionz-rmm/manufacturer-package-validation-5091126-V1610-LAB2-5NIC.txt"
MANUFACTURER_BASELINE_SHA256_FILE="/var/lib/rswsolutionz-rmm/manufacturer-baseline-5091126-V1610-LAB2-5NIC.sha256"
