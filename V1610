    sha256sum -c "${MANUFACTURER_BASELINE_SHA256_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer package validation has a recognized result" \
    grep -Eq '^manufacturer_package_validation=(PASS|DEVIATION)$' "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" || failures=$((failures + 1))
  if grep -q '^manufacturer_package_validation=DEVIATION$' "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" 2>/dev/null; then
    warning_message "Manufacturer package baseline contained a recorded deviation. Final required-package state is validated separately and must pass."
  fi
  check_final_requirement "Final required-package baseline record exists" test -s "${BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Network requirements record exists" test -s "${NETWORK_REQUIREMENTS_FILE}" || failures=$((failures + 1))
  check_final_requirement "Netplan generates successfully" netplan generate || failures=$((failures + 1))
  check_final_requirement "Domotz installed" snap list "${DOMOTZ_SNAP_NAME}" || failures=$((failures + 1))
  check_final_requirement "Post-reboot production validator installed" test -x "${POSTREBOOT_VALIDATOR}" || failures=$((failures + 1))

  local permission
  for permission in "${REQUIRED_DOMOTZ_PERMISSIONS[@]}"; do
    if snap connections "${DOMOTZ_SNAP_NAME}" | awk -v p="${permission}" '
      $1 == p && $3 != "-" {found=1}
      END {exit found ? 0 : 1}
    '; then
      printf '%sPASS - Domotz permission %s connected%s\n' "${COLOR_GREEN}" "${permission}" "${COLOR_RESET}"
    else
      printf '%sFAIL - Domotz permission %s not connected%s\n' "${COLOR_RED}" "${permission}" "${COLOR_RESET}"
      failures=$((failures + 1))
    fi
  done

  progress_message "Domotz is intentionally not revision-pinned; installed revision is recorded for audit."

  echo "------------------------------------------------------------"
  echo "Pre-reboot mandatory failures: ${failures}"
  echo "============================================================"

  (( failures == 0 ))
}

validate_v1610_nics() (
  # Diagnostic installation may proceed with precisely the known absent
  # 04:00.0 I226-V controller. Other missing or substituted NICs remain fatal.
  local i dev iface mac count=0 slot
  local -a slots=(03 04 05 07 08 09)
  local -A seen=()
  for dev in /sys/bus/pci/devices/*; do
    if [[ $(cat "$dev/class" 2>/dev/null) == 0x020000 ]]; then count=$((count+1)); fi
  done
  if (( count == 5 )); then
    [[ ! -e /sys/bus/pci/devices/0000:04:00.0 ]] || {
      echo 'Unexpected five-NIC topology: 04:00.0 is present.' >&2; exit 1;
    }
    slots=(03 05 07 08 09)
    echo 'HARDWARE EXCEPTION: 04:00.0 missing; proceeding with five NICs for LAB ONLY.' >&2
  elif (( count != 6 )); then
    echo "Expected five or six PCI Ethernet controllers; found $count" >&2
    exit 1
  fi
  for i in "${!slots[@]}"; do
    slot="${slots[i]}"
    iface="eno$i"; dev="/sys/class/net/$iface/device"
    [[ -e "$dev" ]] || { echo "Missing interface $iface" >&2; exit 1; }
    [[ $(basename "$(readlink -f "$dev")") == "0000:${slot}:00.0" && $(cat "$dev/vendor") == 0x8086 && $(cat "$dev/device") == 0x125c && $(basename "$(readlink -f "$dev/driver")") == igc ]] || { echo "Invalid PCI/controller/driver mapping for $iface" >&2; exit 1; }
    mac=$(cat "/sys/class/net/$iface/address") || exit 1
    [[ $mac =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ && $mac != 00:00:00:00:00:00 && -z ${seen[$mac]:-} ]] || exit 1
    seen[$mac]=1
    printf '%s | PCI 0000:%s:00.0 | MAC %s | igc\n' "$iface" "$slot" "$mac"
  done
)

lab_platform_gate() (
  set +u
  . /etc/os-release || exit 1
  if [[ "$ID" != ubuntu || "$VERSION_ID" != 24.04 || "$VERSION_CODENAME" != noble || "$VERSION" != '24.04.3 LTS (Noble Numbat)' ]]; then
    printf 'INSTALLATION BLOCKED: Unsupported OS: %s; required Ubuntu 24.04.3 LTS.\n' "${PRETTY_NAME:-unknown}" >&2
    exit 1
  fi
  local vendor model n=0 dev
  vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) || exit 1
  model=$(cat /sys/class/dmi/id/product_name 2>/dev/null) || exit 1
  [[ "${vendor,,}" == *protectli* && "$model" == V1610 ]] || { echo 'INSTALLATION BLOCKED: expected Protectli V1610.' >&2; exit 1; }
  validate_v1610_nics || exit 1
  if grep -Eq '(^|[[:space:]])(net\.ifnames=0|biosdevname=0)([[:space:]]|$)' /proc/cmdline /etc/default/grub /etc/default/grub.d/*.cfg 2>/dev/null; then echo "INSTALLATION BLOCKED: legacy naming parameters present; remove them and reboot first." >&2; exit 1; fi
  [[ -c /dev/ttyS0 ]] || { echo 'INSTALLATION BLOCKED: ttyS0 missing.' >&2; exit 1; }
)

main() {
  parse_args "$@"
  require_root
  if ! lab_platform_gate; then exit 1; fi
  init_logging

  echo "Solutionz RMM Agent build starting."
  echo "Script: ${SCRIPT_NAME}"
  echo "Revision: ${REVISION}"
  echo "Release date: ${RELEASE_DATE}"
  echo "Log: ${LOG_FILE}"

  backup_previous_state
  write_state "phase1_in_progress"
  record_network_requirements

  prompt_confirmation
  preflight_checks
  validate_v1610_nics > "${STATE_DIR}/nic-inventory-${REVISION}.txt"
  chmod 640 "${STATE_DIR}/nic-inventory-${REVISION}.txt"
  capture_manufacturer_baseline
  # This lab build does not freeze repositories or disable security updates.
  install_required_packages
  verify_required_packages
  verify_ssh_service
  configure_time_sync
  configure_tun
  ensure_snapd
  install_domotz
  configure_domotz_permissions
  configure_ufw
  stage_network_config
  repair_resolv_conf
  normalize_host_entries
  configure_grub_and_serial
  install_local_serial_config_tool
  update_banner
  install_postreboot_validation

  if ! final_summary_check; then
    error_exit "Mandatory pre-reboot validation failed."
  fi

  write_state "phase1_complete" \
    "reboot_required=1" \
    "postreboot_validator=${POSTREBOOT_VALIDATOR}" \
    "log=${LOG_FILE}"

  echo
  echo "------------------------------------------------------------"
  progress_message "Phase 1 completed successfully."
  progress_message "Completion Time: $(date -u +%FT%TZ)"
  progress_message "Hostname: $(hostname)"
  progress_message "Script Revision: ${REVISION}"
  progress_message "State File: ${STATE_FILE}"
  progress_message "Log File: ${LOG_FILE}"
  echo "------------------------------------------------------------"
  echo "Manual reboot is required."
  echo "After reboot, systemd will run the post-reboot validation automatically."
  echo
  echo "V1610 direct laptop configuration:"
  echo "  1. Connect the laptop to the V1610 USB-C port labeled COM."
  echo "  2. Open a serial terminal at 115200 baud, 8 data bits, no parity, 1 stop bit."
  echo "  3. Log in with an authorized local account."
  echo "  4. Run: sudo ${LOCAL_CONFIG_TOOL}"
  echo "Domotz update policy: not revision-pinned; installed revision recorded in ${SNAP_BASELINE_FILE}."
}

main "$@"
